# The storage API is the whole source; see repo::artifactory::raw.
source:
  kind: artifactory
  options:
    repository: {{yaml repository.name}}
    ecosystem: raw
    mapping: {{yaml values.mapping}}
target:
  kind: artifactory-generic
  options:
    repository: {{yaml repository.name}}
    mapping: {{yaml values.mapping}}
    overwrite-guard: {{yaml values.overwrite-guard}}
# AQL needs a login with read permission, even on an anonymously readable
# repository, so a server without 'authentication' is refused; option
# 'anonymous: attempt' overrides.
enumerator:
  kind: artifactory
  options:
    repository: {{yaml repository.name}}
    ecosystem: raw
    mapping: {{yaml values.mapping}}
