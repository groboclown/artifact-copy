# Rust artifacts
/target/
/*.profraw
/*.profdata
/coverage.html

# Script and other tool artifacts
/.mypy_cache/
/unused/
__pycache__/
*.py[oc]

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# IDE ephemera

# Local files, not for Git.
.env
/local-*

# Note the unanchored `.env` above is what covers the per-server files that
# manual-integration-tests/setup/start.sh generates, each holding that
# server's passwords.

# Generated by a Nexus server under Sonatype's EULA; fetch locally with
# scripts/fetch-external.sh --nexus-url=URL.
/external/nexus/
