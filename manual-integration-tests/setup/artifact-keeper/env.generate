#!/bin/sh
#
# Extra secrets for this server, appended to its generated `.env` by
# ../start.sh.  Printed rather than written, so the caller owns the file.

set -eu

# Artifact Keeper refuses to start without this, and checks its strength:
# at least 32 characters, not a known placeholder, and at least 16 distinct
# characters (backend/src/config.rs, `jwt_secret_warnings`).
#
# **base64, not hex.**  That distinct-character floor is exactly 16 and hex
# has exactly 16 symbols, so a hex secret that happens to omit one digit is
# rejected - about a 3% chance at 96 characters, which is a start failure
# that would look random.  base64's 64-symbol alphabet has no such edge.
printf 'JWT_SECRET=%s\n' "$(openssl rand -base64 48 | tr -d '\n')"

# Encrypts webhook signing secrets at rest.  Must be 32 bytes, base64.
#
# Optional to the server - omitting it only warns - but a value that is set
# and malformed makes it exit at boot, so it is generated correctly here
# rather than left to be filled in by hand later.
printf 'AK_WEBHOOK_SECRET_KEY=%s\n' "$(openssl rand -base64 32 | tr -d '\n')"
