# Appended to this server's generated `.env` by ../sctl.sh.
#
# Settings rather than secrets: edit them, then recreate the cluster.

# Which repositories to create.
#
# Artifact Keeper serves far more formats than the other two servers here;
# this is the subset the tool can currently use, plus the two from the
# README's list that it cannot read yet.
ARTIFACT_KEEPER_FORMATS="npm pypi maven docker conan generic"

# The host port.  Defaulted clear of Nexus (8081) and Artifactory (8082).
ARTIFACT_KEEPER_PORT=8083

# Pin the server image for a reproducible run.
# ARTIFACT_KEEPER_VERSION=1.1.0
