# Appended to this server's generated `.env` by ../sctl.sh.
#
# Settings rather than secrets: edit them, then recreate the cluster.

# Which repositories to create.
# Some versions of Nexus use "maven2" as the repository type instead of "maven".
NEXUS_FORMATS="raw npm pypi maven cargo"

# Pin the server image for a reproducible run.  Unpinned by default, and
# Cargo needs a recent release.
# NEXUS_VERSION=3.79.0
