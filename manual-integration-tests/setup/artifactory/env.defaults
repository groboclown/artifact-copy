# Appended to this server's generated `.env` by ../sctl.sh.
#
# Settings rather than secrets: edit them, then recreate the cluster.

# Which repositories to create.
#
# Maven, generic, and ivy are what the OSS edition serves.  npm, pypi and
# go are Pro features.  Current images create such a repository without
# complaint; whether they serve it is untested.
ARTIFACTORY_FORMATS="maven generic ivy"

# The host port.  Defaulted away from 8081 so this can run beside Nexus.
ARTIFACTORY_PORT=8082

# Pin the server image for a reproducible run.
# ARTIFACTORY_VERSION=7.146.39
